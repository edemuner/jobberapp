    "lint:check": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier --check 'src/**/*.ts'",
    "prettier:fix": "prettier --fix 'src/**/*.ts'",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json && ts-node tools/copyAssets.ts",
    "test": "jest --coverage=true -w=1 --forceExit --detectOpenHandles=true --watchAll=false"
  },
  "author": "",
  "license": "ISC",
